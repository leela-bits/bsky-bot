{
  "name": "bsky-bot devcontainer",

  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-trixie",

  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "ms-vscode.vscode-typescript-next"],
      "settings": {
        "biome.lsp.bin": "node_modules/.bin/biome"
      }
    }
  },

  "postCreateCommand": "npm ci",

  "remoteUser": "node"
}
