{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["lexicons/"],
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "overrides": [
        {
            "files": ["tsconfig.json"],
            "options": {
                "parser": "jsonc"
            }
        }
    ]
}
